<?xml version="1.0" encoding="utf-8"?>
<!-- Outer margin leaves room for the card's shadow inside the floating window. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Tap: stop early / listen again. Long-press: settings. -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/card_bg"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <dev.inbox.capture.VoiceView
            android:id="@+id/wave"
            android:layout_width="180dp"
            android:layout_height="104dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/chip_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/chip_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Only when auto-save is off or text was shared in. -->
        <TextView
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/pill_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="22dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:paddingBottom="8dp"
            android:text="@string/save"
            android:textColor="@color/on_accent"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
