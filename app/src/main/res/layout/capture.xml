<?xml version="1.0" encoding="utf-8"?>
<!-- Outer margin leaves room for the card's shadow inside the floating window. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/card_bg"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <dev.inbox.capture.VoiceView
            android:id="@+id/wave"
            android:layout_width="180dp"
            android:layout_height="104dp" />

        <!-- Result text sits in the space between the visual and the controls, centred. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/chip_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/chip_text"
            android:textSize="13sp"
            android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/round_bg"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                android:tint="@color/text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/mic"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/mic_bg"
                android:contentDescription="@string/mic"
                android:elevation="2dp"
                android:src="@drawable/ic_mic"
                android:tint="@color/mic_tint" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/save"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/round_bg"
                android:contentDescription="@string/save"
                android:src="@drawable/ic_check"
                android:tint="@color/accent"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
