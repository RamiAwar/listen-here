<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/Label" android:text="Save tasks by" />

        <RadioGroup
            android:id="@+id/mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/mode_uri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sending to Obsidian (obsidian://new). Works with LiveSync; briefly opens Obsidian." />

            <RadioButton
                android:id="@+id/mode_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Writing the file directly. Instant, never opens Obsidian." />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/uri_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Label" android:text="Vault name" />
            <EditText
                android:id="@+id/vault"
                style="@style/Field"
                android:hint="(blank = currently open vault)" />

            <TextView style="@style/Label" android:text="Inbox note (path in vault, no .md)" />
            <EditText
                android:id="@+id/note"
                style="@style/Field"
                android:hint="GTD/Inbox" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/file_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Label" android:text="Inbox file" />
            <TextView
                android:id="@+id/file_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <Button
                android:id="@+id/pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick Inbox.md" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="Line format: {task} {due} {date} {time} {today}" />
        <EditText android:id="@+id/line" style="@style/Field" android:fontFamily="monospace" />

        <TextView style="@style/Label" android:text="{due} when only a date was said" />
        <EditText android:id="@+id/due" style="@style/Field" android:fontFamily="monospace" />

        <TextView style="@style/Label" android:text="{due} when a time was said too" />
        <EditText android:id="@+id/due_time" style="@style/Field" android:fontFamily="monospace" />

        <Button
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset formats (Reminder plugin style)" />

        <Switch
            android:id="@+id/auto_mic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start listening as soon as it opens" />

        <Switch
            android:id="@+id/auto_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save right after dictation (no confirm tap)" />

        <TextView style="@style/Label" android:text="Speech language" />
        <Spinner
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/Label" android:text="Words to favour, one per line (names, projects)" />
        <EditText
            android:id="@+id/keywords"
            style="@style/Field"
            android:gravity="top"
            android:hint="Alex&#10;Garden shed"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <TextView
            style="@style/Label"
            android:text="Speech runs on the phone (Cactus Whistle). The app has no internet permission." />

        <Button
            android:id="@+id/done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="Done" />
    </LinearLayout>
</ScrollView>
